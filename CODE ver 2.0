if s==1:
    a = int(input('what is your Hindi marks'))
if s==2:
    a= int(input('what is your Kanada marks'))
b= int(input("what is your English marks"))
d= int(input("what is your Maths marks"))
e= int(input("what is your Evs marks"))
f= int(input("what is your Computer marks"))
